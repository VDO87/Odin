# ==================================================
# ODIN GENERAL
# ==================================================
ODIN_ENV=TEST
ODIN_MODE=SHADOW_MT5
ODIN_TIMEZONE=Europe/Lisbon

# ==================================================
# SAFETY
# ==================================================
ENABLE_REAL_TRADING=false
ENABLE_AUTO_EXECUTION=false
ENABLE_XTB_REAL=false
ENABLE_MT5_ORDER_SEND=false

MAX_RISK_PER_TRADE_PERCENT=0.25
MAX_DAILY_LOSS_PERCENT=1.00
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=2

# ==================================================
# CONTROL / RECOVERY
# ==================================================
ODIN_AUTO_START=true
ODIN_STARTUP_SAFE_MODE=true
ODIN_REQUIRE_HEALTHCHECK_ON_START=true
ODIN_REQUIRE_POSITION_RECONCILIATION=true
ODIN_BLOCK_ON_MT5_MISMATCH=true
ODIN_BLOCK_ON_NETWORK_RECOVERY=true

# ==================================================
# NETWORK
# ==================================================
NETWORK_MONITOR_ENABLED=true
NETWORK_CHECK_INTERVAL_SECONDS=10
NETWORK_FAILURE_THRESHOLD=3
NETWORK_RECOVERY_STABILIZATION_SECONDS=120

# ==================================================
# LOCAL LLM RUNTIME
# ==================================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_MAX_TOKENS=800
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_REQUIRE_CONTEXT=true
LOCAL_LLM_ALLOW_OUT_OF_SCOPE=false
LOCAL_LLM_LOG_PROMPTS=true
LOCAL_LLM_LOG_RESPONSES=true
LOCAL_LLM_REDACT_SENSITIVE_DATA=true
LOCAL_LLM_HEALTHCHECK_ENABLED=true

# ==================================================
# OPENAI SUPPORT
# ==================================================
OPENAI_SUPPORT_ENABLED=false
OPENAI_DECISION_SUPPORT_ONLY=true
OPENAI_API_KEY=

# ==================================================
# ODIN ASSISTANT
# ==================================================
ODIN_ASSISTANT_ENABLED=true
ODIN_ASSISTANT_CHANNELS=dashboard,telegram
ODIN_ASSISTANT_REQUIRE_REGISTRY=true
ODIN_ASSISTANT_ALLOW_FREE_TEXT=true
ODIN_ASSISTANT_BLOCK_OUT_OF_SCOPE=true
ODIN_ASSISTANT_COMMAND_BUS_REQUIRED=true
ODIN_ASSISTANT_OPENAI_ESCALATION=false

# ==================================================
# ODIN ATLAS
# ==================================================
ATLAS_ENABLED=true
ATLAS_MODE=CONSENSUS_ONLY
ATLAS_ALLOW_DIRECT_EXECUTION=false
ATLAS_REQUIRE_RISK_ENGINE=true
ATLAS_REQUIRE_CRITIC_AGENT=true
ATLAS_MIN_CONSENSUS_SCORE=0.65
ATLAS_OPENAI_ESCALATION_ENABLED=false
ATLAS_AUTO_PROMPT_UPDATE=false
ATLAS_PROMPT_OPTIMIZER_ENABLED=true
ATLAS_PROMPT_OPTIMIZER_MODE=SIMULATION_ONLY
ATLAS_LOG_ALL_AGENT_OUTPUTS=true

# ==================================================
# MARKET INTELLIGENCE
# ==================================================
NEWS_ENABLED=true
ECONOMIC_CALENDAR_ENABLED=true
TRADING_ECONOMICS_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=

# ==================================================
# MT5 SHADOW
# ==================================================
MT5_ENABLED=true
MT5_SHADOW_MODE=true
MT5_ORDER_SEND_ENABLED=false
MT5_RECONCILIATION_ENABLED=true
MT5_BLOCK_UNKNOWN_POSITIONS=true
MT5_BLOCK_UNPROTECTED_POSITIONS=true
MT5_MAGIC_NUMBER_ODIN=870087
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
MT5_DEFAULT_TIMEFRAME=M15
MT5_CANDLE_COUNT=200
MT5_MAX_SPREAD_POINTS=30
MT5_REQUIRE_SL_TP_FOR_MANAGED=true
MT5_ALLOW_POSITION_MODIFICATION=false
MT5_ALLOW_POSITION_CLOSE=false

# ==================================================
# XTB
# ==================================================
XTB_ENABLED=true
XTB_ACCOUNT_TYPE=DEMO
XTB_REAL_ENABLED=false
XTB_DEMO_ENABLED=true
XTB_USER_ID=
XTB_PASSWORD=
XTB_HOST=xapia.x-station.eu
XTB_MAIN_PORT=5124
XTB_STREAM_PORT=5125

# ==================================================
# BROKER ROUTER
# ==================================================
BROKER_ROUTER_ENABLED=true
BROKER_PRIMARY=XTB
BROKER_SECONDARY=IBKR
BROKER_CFD_BACKUP=IG
BROKER_FIRE_PRIMARY=IBKR
BROKER_ALLOW_REAL_EXECUTION=false
BROKER_REQUIRE_RECONCILIATION=true
BROKER_BLOCK_UNKNOWN_POSITIONS=true
BROKER_LOG_ALL_REQUESTS=true
BROKER_LOG_ALL_RESPONSES=true

# ==================================================
# IBKR
# ==================================================
IBKR_ENABLED=false
IBKR_MODE=PAPER
IBKR_HOST=127.0.0.1
IBKR_PORT=
IBKR_CLIENT_ID=870087

# ==================================================
# IG
# ==================================================
IG_ENABLED=false
IG_MODE=DEMO
IG_API_KEY=
IG_ACCOUNT_ID=

# ==================================================
# SAXO
# ==================================================
SAXO_ENABLED=false
SAXO_MODE=SIMULATION
SAXO_APP_KEY=
SAXO_APP_SECRET=

# ==================================================
# DUKASCOPY
# ==================================================
DUKASCOPY_ENABLED=false
DUKASCOPY_MODE=DEMO

# ==================================================
# CTRADER
# ==================================================
CTRADER_ENABLED=false
CTRADER_MODE=DEMO

# ==================================================
# TELEGRAM
# ==================================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REQUIRE_APPROVAL=true

# ==================================================
# DASHBOARD
# ==================================================
DASHBOARD_TERMINAL_ENABLED=true
DASHBOARD_HTML_ENABLED=true
DASHBOARD_CONTROL_ENABLED=true
DASHBOARD_REQUIRE_ADMIN_PIN=true
DASHBOARD_ALLOW_RISK_ADJUSTMENTS=true
DASHBOARD_ALLOW_MODE_CHANGE=true
DASHBOARD_ALLOW_REAL_TRADING_ENABLE=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# ==================================================
# SHADOW RUNTIME LOOP
# ==================================================
ODIN_RUNTIME_ENABLED=true
ODIN_RUNTIME_MODE=SHADOW
ODIN_RUNTIME_HEARTBEAT_SECONDS=10
ODIN_RUNTIME_HEALTHCHECK_SECONDS=60
ODIN_RUNTIME_MT5_POLL_SECONDS=15
ODIN_RUNTIME_ATLAS_CYCLE_SECONDS=60
ODIN_RUNTIME_ASSISTANT_CONTEXT_SECONDS=30
ODIN_RUNTIME_MAX_CYCLE_ERRORS=3
ODIN_RUNTIME_AUTO_RECOVERY=true
ODIN_RUNTIME_STOP_ON_CRITICAL=true
ODIN_RUNTIME_SAFE_SHUTDOWN_TIMEOUT_SECONDS=15

# ==================================================
# OBSERVABILITY
# ==================================================
ODIN_OBSERVABILITY_ENABLED=true
ODIN_STATE_SNAPSHOT_ENABLED=true
ODIN_STATE_SNAPSHOT_FILE=data/runtime/odin_state_snapshot.json
ODIN_HEARTBEAT_FILE=data/runtime/odin_heartbeat.json
ODIN_EVENTS_FILE=data/runtime/odin_events.jsonl

# ==================================================
# SOAK TEST / RUNTIME STABILITY
# ==================================================
ODIN_SOAK_TEST_ENABLED=true
ODIN_SOAK_TEST_DEFAULT_DURATION_SECONDS=300
ODIN_SOAK_TEST_MINI_DURATION_SECONDS=60
ODIN_SOAK_TEST_CYCLE_SLEEP_SECONDS=5
ODIN_SOAK_TEST_MAX_ERRORS=3
ODIN_SOAK_TEST_REQUIRE_NO_REAL_EXECUTION=true
ODIN_SOAK_TEST_VALIDATE_HEARTBEAT=true
ODIN_SOAK_TEST_VALIDATE_SNAPSHOT=true
ODIN_SOAK_TEST_VALIDATE_EVENTS=true
ODIN_SOAK_TEST_VALIDATE_LOG_REDACTION=true
ODIN_SOAK_TEST_FAIL_ON_ORDER_ATTEMPT=true
ODIN_SOAK_TEST_REPORT_DIR=docs/reports
ODIN_SOAK_TEST_OUTPUT_DIR=data/runtime/soak_tests

# ==================================================
# LOGS
# ==================================================
LOG_LEVEL=INFO
LOG_DIR=./logs
AUDIT_LOG_ENABLED=true
