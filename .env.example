# Exemplo sem secrets reais.
# Copiar manualmente para .env apenas quando houver uma fase aprovada.

ODIN_MODE=shadow
ODIN_REAL_TRADING_ENABLED=false
ODIN_HERMES_MODE=readonly
ODIN_LOG_LEVEL=INFO
ODIN_SQLITE_PATH=runtime/odin.sqlite3

# Cache público apenas observacional, preferencialmente no disco D: dentro do WSL.
ODIN_PUBLIC_DATA_CACHE_DIR=/mnt/d/ODIN_LOCAL/cache/public
# Lista explícita, separada por vírgulas, de hosts oficiais permitidos.
# ODIN_PUBLIC_DATA_ALLOWED_HOSTS=data.ecb.europa.eu

# Nunca preencher este ficheiro com chaves reais.
# BROKER_API_KEY=
# LLM_API_KEY=

# P0 OANDA Practice: manter apenas no .env local ignorado pelo Git.
# ODIN_OANDA_PRACTICE_ACCOUNT_ID=
# ODIN_OANDA_PRACTICE_TOKEN=
# ODIN_OANDA_PRACTICE_API_LICENSE_URL=
